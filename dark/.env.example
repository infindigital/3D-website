# ============================================================
# RS Chef'z Website - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.
#
# Full documentation for every variable: docs/ENVIRONMENT.md
# ============================================================

# WhatsApp number used by every "Buy on WhatsApp" button.
# Format: country code + number, digits only, no plus sign, no spaces.
# Example for India: 918548043650
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Canonical site URL used for SEO metadata, Open Graph and sitemaps.
# No trailing slash. Use http://localhost:3000 during local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
